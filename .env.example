# Database connection string (PostgreSQL for production Neon, SQLite for local dev)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Application mode (true enables demo mutations without SSO identity adapter)
DEMO_MODE=true

# Server port and host binding
PORT=8100
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,https://arogyamesh.vercel.app

# Optional AI Copilot Provider (Groq or Gemini)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Vertex AI adapter
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_ACCESS_TOKEN=your_token_here

# Frontend API Origin (Used by Next.js rewrite proxy)
API_ORIGIN=https://your-backend-api.onrender.com

# Frontend Maps (optional)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID
