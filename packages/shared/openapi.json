  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Question": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 1,
            "title": "Question"
          },
          "phc_id": {
            "type": "string",
            "title": "Phc Id",
            "default": "PHC-001"
          },
          "language": {
            "type": "string",
            "enum": [
              "English",
              "Telugu"
            ],
            "title": "Language",
            "default": "English"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "Question"
      },
      "Recommendation": {
        "properties": {
          "recipient_id": {
            "type": "string",
            "title": "Recipient Id",
            "default": "PHC-001"
          },
          "medicine_id": {
            "type": "string",
            "title": "Medicine Id",
            "default": "ors"
          },
          "horizon": {
            "type": "integer",
            "enum": [
              1,
              3,
              7,
              14
            ],
            "title": "Horizon",
            "default": 7
          }
        },
        "type": "object",
        "title": "Recommendation"
      },
      "Scenario": {
        "properties": {
          "district": {
            "type": "string",
            "title": "District",
            "default": "AP-1"
          },
          "event": {
            "type": "string",
            "enum": [
              "dengue",
              "heatwave",
              "respiratory"
            ],
            "title": "Event",
            "default": "dengue"
          },
          "severity": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Severity",
            "default": 2.5
          },
          "duration": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Duration",
            "default": 14
          },
          "staffing": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.25,
            "title": "Staffing",
            "default": 0.75
          }
        },
        "type": "object",
        "title": "Scenario"
      },
      "StockEvent": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Id"
          },
          "phc_id": {
            "type": "string",
            "title": "Phc Id"
          },
          "medicine_id": {
            "type": "string",
            "title": "Medicine Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "RECEIVE",
              "DISPENSE",
              "RECONCILIATION"
            ],
            "title": "Kind"
          },
          "quantity": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Quantity"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "expiry": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiry"
          }
        },
        "type": "object",
        "required": [
          "id",
          "phc_id",
          "medicine_id",
          "kind",
          "quantity",
          "version",
          "timestamp"
        ],
        "title": "StockEvent"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}